{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "soloher-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 3001
    },
    {
      "name": "soloher",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:client"
      ],
      "port": 3000
    },
    {
      "name": "soloher-waitlist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:waitlist",
        "--prefix",
        "client"
      ],
      "port": 3002
    },
    {
      "name": "soloher-cloudflare",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:cloudflare",
        "--prefix",
        "client"
      ],
      "port": 8788
    }
  ]
}
