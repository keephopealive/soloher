# Public address of the Cloudflare Pages build (used for link previews). Not a secret.
# Update this once the project's address (or a custom domain) is confirmed.
VITE_SITE_URL=https://soloher.pages.dev/

# Which buttons this build shows: "waitlist" (pre-launch sign-ups) or "sell" (subscribe / gift).
# Switch to sell on launch day, then run npm run deploy:cloudflare.
VITE_SALES_MODE=waitlist
