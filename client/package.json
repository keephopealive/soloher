{
  "name": "soloher-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:waitlist": "vite --mode waitlist --port 3002",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "build:cloudflare": "tsc && vite build --mode cloudflare",
    "deploy:cloudflare": "node scripts/check-branch.mjs master && npm run build:cloudflare && wrangler pages deploy dist --project-name soloher --branch main"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "gh-pages": "^6.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "wrangler": "3.114.17"
  }
}
